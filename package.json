{
  "name": "eric-shell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n site,storybook -c cyan,magenta --kill-others-on-fail \"npm:dev:site\" \"npm:dev:storybook\"",
    "dev:site": "vercel dev",
    "dev:storybook": "storybook dev -p 6006 --no-open",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "images": "node scripts/generate-responsive-images.mjs",
    "lqip": "node scripts/generate-lqip.mjs",
    "seed:crm": "node scripts/seed-crm.mjs seed",
    "seed:crm:clean": "node scripts/seed-crm.mjs clean",
    "seed:crm:status": "node scripts/seed-crm.mjs status",
    "check:crm-ui": "node scripts/crm-ui-check.mjs",
    "shots": "node scripts/capture-note-shots.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "kerning": "node scripts/display-kerning.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "social": "node scripts/generate-social.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@visx/curve": "^4.0.0",
    "@visx/event": "^4.0.0",
    "@visx/gradient": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@visx/tooltip": "^4.0.0",
    "csv-parse": "^7.0.3",
    "groq-sdk": "^1.1.2",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-intersection-observer": "^10.0.3",
    "react-markdown": "^10.1.0",
    "resend": "^6.12.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.7.13",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright": "^1.61.1",
    "sharp": "^0.35.5",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "26.x"
  }
}
