# Resend API key for the /api/contact serverless function.
# Get one at https://resend.com/api-keys and set it here for local `vercel dev`,
# and in Vercel project settings (Production + Preview + Development) for deploys.
RESEND_API_KEY=

# Groq API key for the /api/chat serverless function (free tier).
# Get one at https://console.groq.com/keys and set it here for local `vercel dev`,
# and in Vercel project settings (Production + Preview + Development) for deploys.
GROQ_API_KEY=

# Where the admin sign-in one-time passcode is emailed (second factor at /login).
#
# OPTIONAL, AND IT FAILS OPEN. Leave it blank and the admin signs in on
# ADMIN_PASSWORD alone. The same fallback applies if RESEND_API_KEY is missing,
# if the Upstash vars are missing, or if the Resend send fails at request time —
# the session is issued anyway and the reason is logged. Deliberate: a
# third-party outage must never lock the owner out of their own dashboard.
# See the tradeoff note in api/_lib/auth.ts.
ADMIN_2FA_EMAIL=
