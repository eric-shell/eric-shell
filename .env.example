# Environment for the serverless functions under api/.
#
# `vercel dev` reads these from the linked Vercel project, not from this file:
# add or change one with `npx vercel env add NAME development` (and again for
# preview / production). The copy below is a reference for which keys exist and
# what happens without each. Only scripts/seed-crm.mjs and
# scripts/merge-visitors.mjs read a local .env.local, and only POSTGRES_URL.
#
# Nothing here is needed to build the site or run its tests.

# ── Database ────────────────────────────────────────────────────────────────

# Neon Postgres. Set automatically by the Neon <-> Vercel integration; check it
# is not empty with `npx vercel env pull`. Absent: chat, contact and telemetry
# still work for visitors (persistence is best-effort) but nothing is recorded,
# and every admin endpoint returns 500.
POSTGRES_URL=

# ── Public endpoints ────────────────────────────────────────────────────────

# Groq, for /api/chat. https://console.groq.com/keys
# Absent: the chat answers every message with "Chat is unavailable".
GROQ_API_KEY=

# Resend, for /api/contact and the admin sign-in code. https://resend.com/api-keys
# Absent: the contact form fails, and admin sign-in drops to password-only.
RESEND_API_KEY=

# Upstash Redis: rate limiting on /api/chat, /api/contact, /api/events and
# /api/track, and storage for the admin sign-in challenge.
# The Vercel Marketplace integration injects KV_REST_API_URL / KV_REST_API_TOKEN
# instead; either pair works.
# Absent: rate limiting is off (fails open) and sign-in drops to password-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Admin CRM (/login, /dashboard) ──────────────────────────────────────────

# The admin password. Absent: every sign-in is rejected.
ADMIN_PASSWORD=

# Signs the session cookie and the sign-in code hash. 32+ random characters.
# Absent or shorter than 16: sign-in returns 500. Rotating it signs every
# session out.
ADMIN_SESSION_SECRET=

# Where the sign-in code is emailed (the second factor).
#
# OPTIONAL, AND IT FAILS OPEN. Leave it blank and the admin signs in on
# ADMIN_PASSWORD alone. The same fallback applies if RESEND_API_KEY is missing,
# if the Upstash vars are missing, or if the Resend send fails at request time —
# the session is issued anyway and the reason is logged. Deliberate: a
# third-party outage must never lock the owner out of their own dashboard.
# See the tradeoff note in api/_lib/auth.ts.
ADMIN_2FA_EMAIL=

# ── Scheduled jobs ──────────────────────────────────────────────────────────

# Vercel Cron sends it as a bearer token to /api/cron/prune, the daily
# six-month retention pass. Absent: that endpoint returns 503 and never runs,
# deliberately, because it deletes data.
CRON_SECRET=
