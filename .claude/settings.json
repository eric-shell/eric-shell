{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "ClaudeInChromeDomain(localhost:3000)",
      "ClaudeInChromeDomain(localhost:6006)",
      "ClaudeInChromeDomain(localhost:4170)",
      "Bash(open http://localhost:3000*)",
      "Bash(open http://localhost:6006*)",
      "Bash(open http://localhost:4170*)",
      "WebFetch(domain:eric.sh)",
      "Bash(.claude/skills/*)",
      "Bash(bash .claude/*)"
    ],
    "ask": [
      "Bash(npm run seed:crm*)"
    ],
    "deny": [
      "Read(./dist/**)",
      "Read(./storybook-static/**)",
      "Read(./package-lock.json)"
    ]
  },
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
